{
  "Comment": "NimbusFlow pipeline: validate -> enrich -> store -> notify. Every state catches, so a failure marks the event failed and emails instead of vanishing.",
  "StartAt": "ValidateData",
  "States": {
    "ValidateData": {
      "Type": "Task",
      "Resource": "${ValidateFunctionArn}",
      "Comment": "Business rules. A ValidationError is terminal - do not retry it.",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleFailure"
        }
      ],
      "Next": "EnrichData"
    },

    "EnrichData": {
      "Type": "Task",
      "Resource": "${EnrichFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleFailure"
        }
      ],
      "Next": "StoreRecord"
    },

    "StoreRecord": {
      "Type": "Task",
      "Resource": "${StoreFunctionArn}",
      "Comment": "Transient DynamoDB failures back off and retry; anything else fails through.",
      "Retry": [
        {
          "ErrorEquals": ["DynamoDbTransientError"],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleFailure"
        }
      ],
      "Next": "NotifySubscribers"
    },

    "NotifySubscribers": {
      "Type": "Task",
      "Resource": "${NotifyFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleFailure"
        }
      ],
      "End": true
    },

    "HandleFailure": {
      "Type": "Task",
      "Comment": "Native SDK integration - no Lambda needed to mark the event failed.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${EventsTableName}",
        "Key": {
          "PK": { "S.$": "States.Format('EVENT#{}', $.eventId)" },
          "SK": { "S": "METADATA" }
        },
        "UpdateExpression": "SET #status = :status, failed_at = :failedAt, error_detail = :errorDetail",
        "ExpressionAttributeNames": { "#status": "status" },
        "ExpressionAttributeValues": {
          ":status": { "S": "failed" },
          ":failedAt": { "S.$": "$$.State.EnteredTime" },
          ":errorDetail": { "S.$": "States.JsonToString($.error)" }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.markFailedError",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "NotifyFailure"
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "NimbusFlow: event failed",
        "Message.$": "States.Format('Event {} failed in the NimbusFlow pipeline. Error: {}', $.eventId, States.JsonToString($.error))"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "PipelineFailed"
        }
      ],
      "Next": "PipelineFailed"
    },

    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "A NimbusFlow pipeline stage failed. The event is marked failed and an SNS email was sent."
    }
  }
}
